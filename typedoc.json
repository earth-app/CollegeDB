{
	"entryPoints": ["src"],
	"out": "typedoc",
	"alwaysCreateEntryPointModule": false,
	"projectDocuments": [
		"docs/getting-started.md",
		"docs/providers.md",
		"docs/drop-in.md",
		"docs/sharding.md",
		"docs/shard-moves.md",
		"docs/architecture.md",
		"docs/reads-and-writes.md",
		"docs/generated-ids.md",
		"docs/query-guidance.md",
		"docs/migration-protocol.md",
		"docs/cloudflare.md",
		"docs/coordinator.md",
		"docs/testing.md",
		"docs/benchmarks.md",
		"docs/api-reference.md",
		"docs/configuration.md"
	],
	"customJs": "scripts/docs/render.js",
	"customCss": "scripts/docs/render.css",
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"sql",
		"diff",
		"toml",
		"yaml"
	],
	"ignoredHighlightLanguages": ["mermaid", "math"],
	"locales": { "en": { "kind_plural_document": "Guides" } },
	"groupOrder": ["Guides", "*"],
	"navigation": { "includeGroups": true }
}
